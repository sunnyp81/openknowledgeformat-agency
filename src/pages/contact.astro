---
import BaseLayout from '../layouts/BaseLayout.astro';

const faq = [
  { q: 'How quickly will you reply?', a: 'We are a small, independent team, so we do not promise an automated instant response. We aim to reply to every genuine enquiry within two working days, and usually sooner.' },
  { q: 'Do I need to understand OKF before I get in touch?', a: 'No. If you can describe where your team’s knowledge currently lives (wikis, docs, support tools, spreadsheets), that is enough to start. We will explain the rest during a readiness audit.' },
  { q: 'Is there any cost to an initial enquiry?', a: 'No. A first conversation and a quote are free. Paid work only begins once scope and price are agreed in writing.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const teamTypes = ['SaaS', 'Data team', 'Support', 'AI product', 'Agency', 'Other'];
const inputCls =
  'mt-1 w-full rounded-md border border-line bg-white px-3 py-2 text-sm text-ink focus:border-accent';
---
<BaseLayout
  title="Contact"
  description="Book an OKF readiness audit, request an implementation quote, or send a general enquiry. Independent Open Knowledge Format specialists."
  schemas={[faqSchema]}
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 pt-8">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-accent">Home</a></li>
        <li class="flex items-center gap-1"><span aria-hidden="true" class="text-line">/</span><span aria-current="page" class="text-ink-soft">Contact</span></li>
      </ol>
    </nav>

    <header class="mb-8 border-b border-line pb-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink">Contact us</h1>
      <p class="mt-4 text-lg text-ink-soft">Whether you are exploring the Open Knowledge Format for the first time or you already know you want a bundle built, this is the place to start. We are an independent implementation agency, not affiliated with or endorsed by Google.</p>
    </header>

    <section class="mb-10 grid gap-4 sm:grid-cols-3" aria-label="Ways to engage">
      <div class="rounded-lg border border-line bg-paper p-5">
        <h2 class="font-semibold text-ink">Book a readiness audit</h2>
        <p class="mt-1 text-sm text-muted">The best starting point for most teams. See the <a class="text-accent hover:text-accent-ink" href="/okf-readiness-audit/">readiness audit</a>.</p>
      </div>
      <div class="rounded-lg border border-line bg-paper p-5">
        <h2 class="font-semibold text-ink">Request a quote</h2>
        <p class="mt-1 text-sm text-muted">Know what you need? Tell us about your knowledge base and we will scope it.</p>
      </div>
      <div class="rounded-lg border border-line bg-paper p-5">
        <h2 class="font-semibold text-ink">General enquiry</h2>
        <p class="mt-1 text-sm text-muted">Questions about OKF, our approach, or whether we are the right fit.</p>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-ink">Send an enquiry</h2>
      <p class="mt-2 text-sm text-muted">
        This form is not yet connected to a backend. Before launch, wire it to
        Formspree or Netlify Forms (update the <code>action</code>). Until then,
        please email us directly at
        <a class="text-accent hover:text-accent-ink" href="mailto:hello@openknowledgeformat.agency?subject=OKF%20enquiry">hello@openknowledgeformat.agency</a>.
      </p>

      <form class="mt-6 grid gap-5" action="https://formspree.io/f/your-form-id" method="POST">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="text-sm font-medium text-ink">Name <span class="text-accent">*</span></label>
            <input id="name" name="name" type="text" required class={inputCls} />
          </div>
          <div>
            <label for="email" class="text-sm font-medium text-ink">Work email <span class="text-accent">*</span></label>
            <input id="email" name="email" type="email" required class={inputCls} />
          </div>
          <div>
            <label for="company" class="text-sm font-medium text-ink">Company</label>
            <input id="company" name="company" type="text" class={inputCls} />
          </div>
          <div>
            <label for="team" class="text-sm font-medium text-ink">Team type <span class="text-accent">*</span></label>
            <select id="team" name="team_type" required class={inputCls}>
              <option value="" selected disabled>Select one</option>
              {teamTypes.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
        </div>
        <div>
          <label for="sources" class="text-sm font-medium text-ink">Knowledge sources</label>
          <input id="sources" name="knowledge_sources" type="text" placeholder="e.g. Confluence, Notion, Google Docs, help desk" class={inputCls} />
        </div>
        <div>
          <label for="message" class="text-sm font-medium text-ink">Message <span class="text-accent">*</span></label>
          <textarea id="message" name="message" rows="5" required class={inputCls}></textarea>
        </div>
        <div>
          <label for="hear" class="text-sm font-medium text-ink">How did you hear about us?</label>
          <input id="hear" name="how_heard" type="text" class={inputCls} />
        </div>
        <div>
          <button type="submit" class="rounded-md bg-accent px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-ink">Send enquiry</button>
        </div>
      </form>
    </section>

    <section class="mb-10 rounded-lg border border-line bg-paper-2/50 p-6">
      <h2 class="font-semibold text-ink">What happens next</h2>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm text-ink-soft">
        <li>We read your enquiry and reply within two working days, usually sooner.</li>
        <li>If it looks like a fit, we propose a short call or a readiness audit.</li>
        <li>You receive a written scope and a fixed quote before any paid work begins. No surprises, no lock-in.</li>
      </ol>
    </section>

    <section class="mb-16" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl font-bold text-ink mb-6">Frequently asked questions</h2>
      <div class="divide-y divide-line rounded-xl border border-line bg-white">
        {faq.map((f) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-medium text-ink list-none">
              <span>{f.q}</span>
              <span class="text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-ink-soft">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
