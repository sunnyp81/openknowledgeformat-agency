---
import { NAV, OFFICIAL, SITE_NAME_SHORT, PRIMARY_CTA } from '../consts';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line bg-paper-2/60">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2 font-semibold text-ink">
          <span
            class="grid h-7 w-7 place-items-center rounded bg-accent text-white font-mono text-xs"
            aria-hidden="true">{'{ }'}</span>
          {SITE_NAME_SHORT}
        </div>
        <p class="mt-3 max-w-sm text-sm text-muted">
          Independent implementation agency for the Open Knowledge Format. We
          convert operational knowledge into agent-readable OKF bundles. Not
          affiliated with, sponsored by, or endorsed by Google.
        </p>
        <a href={PRIMARY_CTA.href} class="mt-4 inline-block rounded-md border border-accent px-4 py-2 text-sm font-semibold text-accent hover:bg-accent hover:text-white">
          {PRIMARY_CTA.label}
        </a>
      </div>

      <nav aria-label="Footer">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Agency</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {NAV.map((item) => (
            <li><a class="text-ink-soft hover:text-accent" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-muted">Official OKF</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-ink-soft hover:text-accent" href={OFFICIAL.blog} rel="noopener nofollow" target="_blank">Google Cloud announcement<span class="sr-only"> (opens in new tab)</span></a></li>
          <li><a class="text-ink-soft hover:text-accent" href={OFFICIAL.spec} rel="noopener nofollow" target="_blank">OKF specification<span class="sr-only"> (opens in new tab)</span></a></li>
          <li><a class="text-ink-soft hover:text-accent" href={OFFICIAL.academy} rel="noopener" target="_blank">Learn OKF (Academy)<span class="sr-only"> (opens in new tab)</span></a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-line pt-6 text-xs text-muted">
      <p>&copy; {year} {SITE_NAME_SHORT}. Independent agency. "Open Knowledge Format" and "Google Cloud" are referenced for descriptive purposes only. All pricing on this site is indicative.</p>
    </div>
  </div>
</footer>
